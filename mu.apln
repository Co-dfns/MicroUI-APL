scrollbar←{cnt b cs (x y w h)←⍵
	maxscroll←cs[y]-b[h]
	(maxscroll>0)⍲b[h]>0:containers[cnt;cnt_scroll[y]]←0
	id←get_id '!scrollbar','xy'[y]
	base←b ⋄ base[x]←b[x]+b[w] ⋄ base[w]←style_scrollbar_size
	update_control id base:
	t←(focus=id)∧1 0 0≡mouse_down
	containers[cnt;cnt_scroll[y]]+←t×⌊(mouse_delta[y]×cs[y])÷base[h]
	containers[cnt;cnt_scroll[y]]←maxscroll⌊0⌈containers[cnt;cnt_scroll[y]]
	0 draw_frame base color_scrollbase:
	thumb←base
	thumb[h]←style_thumb_size⌈⌊(base[h]×b[h])÷cs[y]
	thumb[y]+←⌊(containers[cnt;cnt_scroll[y]]×base[h]-thumb[h])÷maxscroll
	0 draw_frame thumb color_scrollthumb:
	mouse_over b:_←0⊣scroll_target∘←cnt
_←0}

scrollbars←{cnt←⍺ ⋄ body←⍵
	cs←containers[cnt;cnt_content_size]+2×style_padding
	push_clip_rect body:
	body[3 2]-←(cs>containers[cnt;cnt_body[2 3]])×style_scrollbar_size
	scrollbar cnt body cs (0 1 2 3):
	scrollbar cnt body cs (1 0 3 2):
	pop_clip_rect:
	body
}

∇res←{opt}begin_window(title rect);cnt;id;body;tr;r;sz
 res←MT_RES ⋄ →∆⍴⍨0≠⎕NC'opt' ⋄ opt←MT_OPT
 
∆:cnt←opt get_container_id id←get_id title
 →0⌿⍨(¯1=cnt)≥containers[cnt;cnt_open]
 id_stack[id_stack_idx]←id ⋄ id_stack_idx+←1
 tr←containers[cnt;cnt_rect[2]]=0
 containers[cnt;cnt_rect]←(rect×tr)+containers[cnt;cnt_rect]×~tr
 begin_root_container cnt
 rect←body←containers[cnt;cnt_rect]
 {}draw_frame⍣(~opt[OPT_NOFRAME])⊢rect color_windowbg

 →opt[OPT_NOTITLE]⍴DRAW_RESIZE_HANDLE
 tr←style_title_height@3⊢rect
 0 draw_frame tr color_titlebg
 id←get_id '!title'
 opt update_control id tr
 opt draw_control_text title tr color_titletext
 containers[cnt;2↑cnt_rect]+←mouse_delta×(focus=id)∧1 0 0≡mouse_down
 body[1 3]+←1 ¯1×style_title_height
 
 →opt[OPT_NOCLOSE]⍴DRAW_RESIZE_HANDLE
 id←get_id '!close'
 r←((tr[0]+tr[2])-tr[3]),tr[1 3 3] ⋄ tr[2]-←r[2]
 ICON_CLOSE draw_icon r color_titletext
 opt update_control id r
 containers[cnt;cnt_open]×←(focus=id)⍲1 0 0≡mouse_pressed 

DRAW_RESIZE_HANDLE:
 opt push_container_body cnt body
 →opt[OPT_NORESIZE]⍴RESIZE_TO_CONTENT
 sz←style_title_height
 id←get_id '!resize'
 r←((rect[0]+rect[2])-sz)((rect[1]+rect[3])-sz) sz sz
 opt update_control id r
 →RESIZE_TO_CONTENT⍴⍨(focus=id)⍲1 0 0≡mouse_down
 containers[cnt;¯2↑cnt_rect]←96 64⌈containers[cnt;¯2↑cnt_rect]+mouse_delta
 
RESIZE_TO_CONTENT:→(~opt[OPT_AUTOSIZE])⍴CLOSE_IF_POPUP
 containers[cnt;¯2↑cnt_rect]-←layout_stack[get_layout;¯2↑lyt_body]
 containers[cnt;¯2↑cnt_rect]+←containers[cnt;cnt_content_size]

CLOSE_IF_POPUP:
 containers[cnt;cnt_open]×←~opt[OPT_POPUP]∧(∨⌿mouse_pressed)∧hover_root≠cnt

 push_clip_rect containers[cnt;cnt_body]
 res[RES_ACTIVE]←1
∇

∇{z}←end_window
 z←0 ⋄ pop_clip_rect ⋄ end_root_container
∇

