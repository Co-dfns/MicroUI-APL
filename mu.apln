∇{Z}←begin
 command_list_idx←0 ⋄ root_list_idx←0 ⋄ scroll_target←¯1
 hover_root←next_hover_root ⋄ next_hover_root←¯1
 mouse_delta←mouse_pos-last_mouse_pos
 frame+←1
 Z←0
∇

∇{Z}←end;t;r;i
 Z←0
 assert 0=container_stack_idx clip_stack_idx id_stack_idx layout_stack_idx

 containers[0⌈scroll_target;cnt_scroll]+←(scroll_target≥0)×scroll_delta
 focus×←updated_focus ⋄ updated_focus←0

 t←(∨⌿mouse_pressed)∧(next_hover_root≠¯1)
 t∧←last_zindex>containers[0⌈next_hover_root;cnt_zindex]
 t∧←0≤containers[0⌈next_hover_root;cnt_zindex]
 {}bring_to_front⍣t⊢next_hover_root
 
 key_pressed←MT_KEY
 text_input←''
 mouse_pressed←MT_MOUSE
 scroll_delta←MT_VEC
 last_mouse_pos←mouse_pos
 
 →0⍴⍨root_list_idx=0
 root_list[i]←r←r[⍋containers[r←root_list[i←⍳root_list_idx];cnt_zindex]]
 (0 jump_dst⊃command_list)←1+containers[r[0];cnt_head]
 2{(containers[⍺;cnt_tail] jump_dst⊃command_list)←1+containers[⍵;cnt_head]}⌿r
 (containers[⊃⌽r;cnt_tail] jump_dst⊃command_list)←command_list_idx
∇

set_focus←{focus∘←⍵ ⋄ updated_focus∘←1 ⋄ _←0}

get_id←{
	id_stack_idx=0:⊢last_id∘←HASH_INITIAL hash ⍵
	⊢last_id∘←id_stack[id_stack_idx-1] hash ⍵
}

push_id←{id_stack[id_stack_idx]←get_id ⍵ ⋄ id_stack_idx+←1 ⋄ _←0}

∇{z}←pop_id
 z←0 ⋄ id_stack_idx-←1
∇

push_clip_rect←{
	clip_stack[clip_stack_idx;]←⍵ intersect_rects get_clip_rect
	clip_stack_idx+←1
_←0}

∇{z}←pop_clip_rect
 z←0 ⋄ clip_stack_idx-←1
∇

∇z←get_clip_rect
 z←clip_stack[clip_stack_idx-1;]
∇

check_clip←{rx ry rw rh←⍵ ⋄ cx cy cw ch←get_clip_rect
	(rx>cx+cw)∨(cx>rx+rw)∨(ry>cy+ch)∨(cy>ry+rh):CLIP_ALL
	(rx≥cx)∧((rx+rw)≤cx+cw)∧(ry≥cy)∧((ry+rh)≤cy+ch):0
	CLIP_PART
}

bring_to_front←{containers[⍵;cnt_zindex]←last_zindex∘←last_zindex+1 ⋄ _←⍵}

⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝
⍝ Containers                                                                   ⍝
⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝

∇z←get_current_container
 z←container_stack[container_stack_idx-1]
∇

get_container←{get_container_id get_id ⍵}

∇{z}←pop_container;cnt;lyt
 z←0 ⋄ cnt←get_current_container ⋄ lyt←get_layout
 containers[cnt;cnt_content_size]←-⌿layout_stack[lyt;lyt_max⍪⍉⍪2↑lyt_body]
 container_stack_idx-←1 ⋄ layout_stack_idx-←1 ⋄ pop_id
∇

get_container_id←{⍺←MT_OPT ⋄ opt←⍺ ⋄ idx←container_pool pool_get ⍵
	idx≥0:pool_update_container⍣(containers[idx;cnt_open]≥opt[OPT_CLOSED])⊢idx
	opt[OPT_CLOSED]:¯1
	containers[idx←pool_init_container ⍵;]←1@cnt_open⊢MT_CONTAINER
	bring_to_front idx
}

push_container_body←{⍺←MT_OPT ⋄ opt←⍺ ⋄ cnt body←⍵
	body←cnt scrollbars⍣(~opt[OPT_NOSCROLL])⊢body
	(body expand_rect -style_padding)push_layout containers[cnt;cnt_scroll]:
	containers[cnt;cnt_body]←body
_←0}

begin_root_container←{cnt←⍵
	container_stack[container_stack_idx]←cnt ⋄ container_stack_idx+←1
	root_list[root_list_idx]←cnt ⋄ root_list_idx+←1
	push_jump ¯1: ⋄ containers[cnt;cnt_head]←command_list_idx-1
	t←¯1=next_hover_root
	t∨←containers[cnt;cnt_zindex]>containers[0⌈next_hover_root;cnt_zindex]
	t∧←containers[cnt;cnt_rect] rect_overlaps_vec2 mouse_pos
	next_hover_root∘←t⊃next_hover_root cnt
	clip_stack[clip_stack_idx;]←UNCLIPPED_RECT ⋄ clip_stack_idx+←1
_←0}


∇{z}←end_root_container;cnt
 z←0 ⋄ cnt←get_current_container
 push_jump ¯1 ⋄ containers[cnt;cnt_tail]←command_list_idx-1
 (containers[cnt;cnt_head] jump_dst⊃command_list)←command_list_idx
 pop_clip_rect
 pop_container
∇

∇z←in_hover_root;stk
 stk←⌽container_stack_idx↑container_stack
 z←(stk⍳hover_root)≤+⌿∧⍀¯1=containers[stk;cnt_head]
∇

⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝⍝
